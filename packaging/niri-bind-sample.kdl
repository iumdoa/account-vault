// Account Vault niri 配置示例与说明
// 适用版本：niri 26.04+

// 1. 窗口浮动规则与初始尺寸 (添加到 window-rule 区域)
window-rule {
    match app-id=r#"^dev\.local\.account_vault$"#
    open-floating true
    default-column-width { fixed 680; }
    default-window-height { fixed 460; }
}

// 2. 全局快捷键绑定 (合并到 binds { ... } 区域中)
// 推荐快捷键 Super+Alt+P (或自定义如 Alt+P、Ctrl+Alt+P)
binds {
    Super+Alt+P repeat=false {
        spawn "/home/iumdoa/.local/bin/account-vault" "--show";
    }
}
